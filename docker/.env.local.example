# ===================================================================
# masitcon Zeiterfassung (Ameise) – Lokale Docker-Umgebung
# ===================================================================
# Template – kopieren und ausfüllen:
#   cp docker/.env.local.example docker/.env.local
#
# ODER: npm run setup generiert docker/.env.local automatisch.
#
# WICHTIG: docker/.env.local NICHT committen! (.gitignore bereits gesetzt)
# Diese Datei (.env.local.example) hingegen ist committed – als Dokumentation.
# ===================================================================

# ── Docker Compose Isolation ─────────────────────────────────────────
# Isoliert Container von anderen lokalen Projekten.
# Alle Container heißen: ameise-local-{db,kong,rest,auth,storage,meta,studio,inbucket}
COMPOSE_PROJECT_NAME=ameise-local

# ── Kryptografische Schlüssel ─────────────────────────────────────────
# Von dev-setup.sh automatisch generiert.
# JWT_SECRET: Signiert alle JWTs (Supabase-intern).
# ANON_KEY / SERVICE_ROLE_KEY: JWTs aus JWT_SECRET für anon / service_role.
# PG_META_CRYPTO_KEY: Verschlüsselung in postgres-meta.
JWT_SECRET=
POSTGRES_PASSWORD=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

# ── Ports ─────────────────────────────────────────────────────────────
# Alle auf 0.0.0.0 (Mac Docker Desktop Standard).
# Bei Port-Konflikten mit anderen lokalen Projekten hier anpassen.
API_PORT=8100            # Kong → NEXT_PUBLIC_SUPABASE_URL
DB_PORT=5433             # PostgreSQL (direkt, z.B. für TablePlus)
STUDIO_PORT=3101         # Supabase Studio
INBUCKET_WEB_PORT=9000   # Inbucket Web-UI (E-Mails lesen)
INBUCKET_SMTP_PORT=2500  # SMTP (nur intern für GoTrue)

# ── URLs ──────────────────────────────────────────────────────────────
# Müssen zu API_PORT passen.
# SITE_URL: Basis-URL der App (GoTrue auth redirects).
# API_EXTERNAL_URL: Öffentliche URL von Kong (aus Browsersicht).
SITE_URL=http://localhost:3000
SITE_HOSTNAME=localhost
API_EXTERNAL_URL=http://localhost:8100

# ── App-Secrets (Server-seitig, für Next.js API Routes) ──────────────
# DATA_TRANSFER_PASSWORD: Passwort für Datentransfer-Route.
# Lokal kann ein beliebiger Wert verwendet werden.
DATA_TRANSFER_PASSWORD=local-dev-password

# ── SMTP ──────────────────────────────────────────────────────────────
# Standard: Inbucket (fängt E-Mails lokal ab – http://localhost:9000)
# SMTP_HOST leer lassen → GoTrue nutzt den Inbucket-Container automatisch.
#
# Für echten E-Mail-Versand (z.B. Strato):
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS ausfüllen.
#   GoTrue verwendet dann den echten SMTP-Server statt Inbucket.
SMTP_ADMIN_EMAIL=admin@ameise.local
SMTP_SENDER_NAME=Ameise Local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# ── Optionale Defaults (normalerweise nicht aendern) ─────────────────
# Diese Variablen haben sinnvolle Defaults in docker-compose.local.yml.
# Nur setzen wenn vom Default abgewichen werden soll.
#
# POSTGRES_DB=postgres
# JWT_EXPIRY=3600
# PGRST_DB_SCHEMAS=public,storage
# DISABLE_SIGNUP=false
# ADDITIONAL_REDIRECT_URLS=
# ENABLE_ANONYMOUS_USERS=false
# STUDIO_DEFAULT_ORGANIZATION=Masitcon Local
# STUDIO_DEFAULT_PROJECT=Ameise Local
