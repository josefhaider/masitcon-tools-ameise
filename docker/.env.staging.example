# ===================================================================
# Ameise Zeiterfassung - Docker Compose Environment (Staging)
# ===================================================================
# Template fuer die Staging-Instanz (z.B. auf demselben Server wie Produktion).
# Wird von server-setup.sh automatisch als docker/.env generiert.
#
# Manuell (lokales Staging):
#   cp docker/.env.staging.example docker/.env.staging
#   # Werte anpassen, dann:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env.staging up -d
#
# Restore auf Staging-Server:
#   bash scripts/restore-legacy-backup.sh restore backup.sql --env docker/.env.staging
#   (Auf dem Server: --env docker/.env, da dort nur eine Instanz pro Verzeichnis)
#
# ACHTUNG: Enthaelt Secrets! Niemals committen.
# ===================================================================

# ── Stack-Identifikation ──────────────────────────────────────────
# Container-Prefix: ameise-staging-{service}
COMPOSE_PROJECT_NAME=ameise-staging

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_PASSWORD=HIER_GENERIERTES_PASSWORT
POSTGRES_DB=postgres

# ── JWT / API Keys ────────────────────────────────────────────────
JWT_SECRET=HIER_GENERIERTER_JWT_SECRET
JWT_EXPIRY=3600
ANON_KEY=HIER_GENERIERTER_ANON_KEY
SERVICE_ROLE_KEY=HIER_GENERIERTER_SERVICE_ROLE_KEY

# ── Ports ─────────────────────────────────────────────────────────
# Production: 3000/8000/5432/3100
# Staging:    3010/8010/5442/3110  <- Staging-Ports vermeiden Konflikte auf gleichem Server
API_PORT=8010
DB_PORT=5442
APP_PORT=3010
STUDIO_PORT=3110

# ── Auth / Site ───────────────────────────────────────────────────
SITE_URL=https://staging.zeiterfassung.masitcon.de
SITE_HOSTNAME=staging.zeiterfassung.masitcon.de
API_EXTERNAL_URL=https://staging.zeiterfassung.masitcon.de/supabase
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# ── SMTP ──────────────────────────────────────────────────────────
# Port 587 (STARTTLS) verwenden -- Port 465 (SMTPS) funktioniert nicht aus Docker.
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=user@masitcon.de
SMTP_PASS=HIER_SMTP_PASSWORT
SMTP_ADMIN_EMAIL=user@masitcon.de
SMTP_SENDER_NAME=Ameise Zeiterfassung

# ── Studio / pg-meta ─────────────────────────────────────────────
PG_META_CRYPTO_KEY=HIER_GENERIERTER_KEY
STUDIO_DEFAULT_ORGANIZATION=Masitcon
STUDIO_DEFAULT_PROJECT=Ameise

# ── PostgREST ─────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage

# ── Next.js (wird ins Browser-Bundle gebacken) ───────────────────
# Wird von server-setup.sh automatisch auf PROTOCOL://HOSTNAME/supabase gesetzt
NEXT_PUBLIC_SUPABASE_URL=

# ── App-Konfiguration ────────────────────────────────────────────
# Passwort fuer die geschuetzte Datentransfer-API-Route
DATA_TRANSFER_PASSWORD=HIER_GENERIERTES_PASSWORT

# ── Docker-Netzwerk ──────────────────────────────────────────────
# Production und Staging brauchen unterschiedliche Subnets auf demselben Server!
# Production: 172.20.0.0/16, Staging: 172.21.0.0/16
DOCKER_SUBNET=172.21.0.0/16
