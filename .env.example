# === Ameise - Umgebungsvariablen ===
# ───────────────────────────────────────────────────────────────────────────────
# LOKALE ENTWICKLUNG:
#   npm run setup generiert .env.local automatisch.
#
# SERVER (SELF-HOSTED SUPABASE):
#   bash scripts/server-setup.sh generiert docker/.env automatisch.
#   Siehe docker/.env.example fuer die vollstaendige Produktions-Vorlage.
#   NIEMALS in git committen!
# ───────────────────────────────────────────────────────────────────────────────

# Supabase (lokal automatisch via dev-setup.sh gesetzt)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8100
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-seitige Secrets (NIE im Browser!)
SUPABASE_SERVICE_ROLE_KEY=
DATA_TRANSFER_PASSWORD=sicheres-passwort-hier

# Datenbank (nur fuer Docker Compose)
POSTGRES_PASSWORD=
JWT_SECRET=

# SMTP (optional, fuer E-Mail-Versand)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Ameise Zeiterfassung
SMTP_ADMIN_EMAIL=

# Produktion: Weitere Variablen (siehe docker/.env.example)
# PG_META_CRYPTO_KEY=
# DOCKER_SUBNET=172.20.0.0/16
