# masitcon Zeiterfassung (Ameise) - Umgebungsvariablen
# Kopiere nach .env und passe die Werte an.
#
# Für Staging/Produktion: .env.staging und .env.production anlegen.
# Vite lädt automatisch: .env.[mode] (z.B. .env.staging bei npm run build:staging)

# Supabase (Frontend – zur Build-Zeit injiziert)
VITE_SUPABASE_URL=http://127.0.0.1:54331
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Produktion: .env.production
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Staging: .env.staging (andere Supabase-Instanz möglich)
# VITE_SUPABASE_URL=https://staging-xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
