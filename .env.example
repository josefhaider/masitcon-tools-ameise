# masitcon Zeiterfassung (Ameise) – Umgebungsvariablen
# ───────────────────────────────────────────────────────────────────────────────
# LOKALE ENTWICKLUNG:
#   Kopiere nach .env und passe an. deploy.sh --local schreibt .env automatisch.
#
# SERVER (SELF-HOSTED SUPABASE):
#   Alle Werte werden von deploy.sh interaktiv abgefragt und in
#   /opt/projects/masitcon-tools-ameise/secrets.env gespeichert (chmod 600).
#   NIEMALS secrets.env in git committen!
#
# Vite lädt automatisch: .env, .env.local, .env.[mode]
# ───────────────────────────────────────────────────────────────────────────────

# ── Frontend (zur Build-Zeit in die SPA eingebettet) ─────────────────────────
# Lokal:   http://127.0.0.1:54335  (supabase start → supabase status)
# Server:  https://zeiterfassung.example.com/supabase  (auto. von deploy.sh gesetzt)
VITE_SUPABASE_URL=http://127.0.0.1:54335
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status

# ── Supabase Self-Hosted (Server – wird von deploy.sh generiert) ─────────────
# Zur Information: Diese Werte stehen in secrets.env auf dem Server.
# JWT_SECRET=                   # 64-stelliger Hex-String (openssl rand -hex 32)
# POSTGRES_PASSWORD=            # Datenbank-Passwort (auto-generiert)
# ANON_KEY=                     # JWT für anonyme API-Anfragen (auto-generiert)
# SERVICE_ROLE_KEY=             # JWT für Admin-API-Anfragen (auto-generiert)
# PG_META_CRYPTO_KEY=           # Supabase Meta API (auto-generiert)

# ── Edge Functions (supabase/.env) ───────────────────────────────────────────
# Wird von deploy.sh --local automatisch geschrieben.
# SUPABASE_URL=http://127.0.0.1:54335
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATA_TRANSFER_PASSWORD=beliebiges-passwort
# ALLOWED_ORIGIN=http://localhost:8080

# ── SMTP (optional – nur für Passwort-Reset / Einladungs-E-Mails) ────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=no-reply@example.com
# SMTP_SENDER_NAME=Ameise
